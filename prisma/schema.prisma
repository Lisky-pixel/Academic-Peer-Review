// Academic Peer Review data model.
//
// Conventions used throughout:
//
//  * UUIDv7 primary keys — time-sortable, so index locality stays good as the
//    table grows, without exposing a guessable sequential id in URLs.
//  * Prisma's default naming (PascalCase tables, camelCase columns). All access
//    goes through Prisma; the rare raw query quotes identifiers.
//  * Records are kept, not deleted. History is the point of this system, so
//    relations that represent facts use onDelete: Restrict. Only rows that are
//    purely derived (sessions, tokens) cascade.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────────────────

/// USER is a submitter. A REVIEWER can also submit papers of their own.
/// ORGANISER runs the conferences they are attached to; ADMIN runs the
/// platform and can act as the organiser of any conference.
enum Role {
  USER
  REVIEWER
  ORGANISER
  ADMIN
}

enum UserStatus {
  UNVERIFIED // self-registered, has not yet confirmed the email address
  INVITED // invited, has not set a password yet
  ACTIVE
  SUSPENDED
}

enum TokenPurpose {
  INVITE
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/// The paper lifecycle. Transitions are defined in lib/workflow/transitions.ts
/// and applied only by lib/workflow/state-machine.ts — never assign this field
/// directly.
enum SubmissionStatus {
  DRAFT // being written; private to the submitter
  SUBMITTED // in, waiting for reviewers; the submitter may still edit it
  UNDER_REVIEW // reviewers assigned; locked
  REVIEWS_COMPLETE // every review is in; waiting for the organiser's decision
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PaperType {
  QUANTITATIVE
  QUALITATIVE
  CONCEPTUAL
  REVIEW
}

enum SubmissionFormat {
  FULL_PAPER // a file is required
  ABSTRACT_ONLY // reviewed on the abstract; a file is optional
}

enum AssignmentStatus {
  PENDING // offered, not yet answered
  ACCEPTED
  DECLINED
  CANCELLED // withdrawn by the organiser, or by a decision made without it
  COMPLETED // review submitted
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
}

enum FileKind {
  ORIGINAL // the paper, uploaded by the submitter
  ANNOTATED // a marked-up copy from a reviewer; scrubbed before anyone sees it
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

enum NotificationType {
  // to the submitter
  SUBMISSION_RECEIVED
  DECISION_MADE

  // to the reviewer
  ASSIGNMENT_RECEIVED
  ASSIGNMENT_CANCELLED
  DEADLINE_APPROACHING

  // to the organisers
  NEEDS_REVIEWERS
  REVIEWS_COMPLETE
  REVIEW_OVERDUE
  PAYMENT_RECEIPT
}

// ──────────────────────────────────────────────────────────────────────────
// Identity
// ──────────────────────────────────────────────────────────────────────────

model User {
  id String @id @default(uuid(7)) @db.Uuid

  /// Always stored lowercase. Normalisation happens in lib/auth rather than via
  /// a citext column, so the behaviour is identical on any Postgres host.
  email        String     @unique
  name         String
  /// Null until an invited person completes their invite and chooses one.
  passwordHash String?
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)

  /// Where the person works or studies. Used to keep reviewers away from
  /// papers from their own institution.
  institution String?

  /// Optional short description. Shown to administrators only.
  bio String?

  /// Profile picture, served only through an access check. See
  /// app/avatar/[userId]/route.ts.
  avatar          Bytes?
  avatarMime      String?
  avatarUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewerProfile     ReviewerProfile?
  sessions            Session[]
  tokens              Token[]
  submissions         Submission[]          @relation("SubmissionAuthor")
  decisionsMade       Submission[]          @relation("SubmissionDecider")
  assignmentsToReview Assignment[]          @relation("AssignmentReviewer")
  assignmentsMade     Assignment[]          @relation("AssignmentAssigner")
  organising          ConferenceOrganiser[]
  paymentsRecorded    Payment[]
  uploadedFiles       StoredFile[]
  notifications       Notification[]
  activityLogs        ActivityLog[]

  @@index([role, status])
}

/// What a reviewer brings: used for matching and shown to organisers.
model ReviewerProfile {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  academicRank    String
  yearsExperience Int
  /// Areas of expertise in the reviewer's own words.
  expertise       String

  disciplines Discipline[]

  /// The reviewer's CV, visible to organisers and administrators only.
  cvStorageKey String?
  cvFilename   String?
  cvSizeBytes  Int?
  cvUploadedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id String @id @default(uuid(7)) @db.Uuid

  /// SHA-256 of the cookie token. The raw token exists only in the user's
  /// cookie, so a database leak cannot be replayed as a login.
  tokenHash String @unique

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

model Token {
  id String @id @default(uuid(7)) @db.Uuid

  /// Hashed, for the same reason as Session.tokenHash.
  tokenHash String       @unique
  purpose   TokenPurpose

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  /// Set the moment the token is used — single-use.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose])
}

// ──────────────────────────────────────────────────────────────────────────
// Conferences
// ──────────────────────────────────────────────────────────────────────────

/// A broad area of research. One list for the whole platform, so a reviewer's
/// disciplines can be matched against papers from any conference.
model Discipline {
  id        String  @id @default(uuid(7)) @db.Uuid
  name      String  @unique
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  reviewers   ReviewerProfile[]
  submissions Submission[]

  @@index([isActive, sortOrder])
}

model Conference {
  id String @id @default(uuid(7)) @db.Uuid

  name        String
  /// Used in URLs and references, e.g. "acsa-2026".
  slug        String  @unique
  description String?
  venue       String?
  startsOn    DateTime?
  endsOn      DateTime?

  /// The call for papers.
  submissionsOpenAt  DateTime
  submissionsCloseAt DateTime
  /// When reviews are due.
  reviewDeadline     DateTime

  reviewersPerPaper    Int              @default(2)
  maxPapersPerReviewer Int              @default(4)
  /// True: reviewers do not see who wrote a paper. Reviewers are never named
  /// to authors either way.
  doubleBlind          Boolean          @default(true)
  submissionFormat     SubmissionFormat @default(FULL_PAPER)
  /// The topics submitters choose from. "Other" is always offered as well.
  topics               String[]

  /// The package the organiser bought, and the papers it allows in total.
  packageName     String?
  submissionLimit Int?

  /// Set when reviewers were last matched automatically, after the call closed.
  matchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisers  ConferenceOrganiser[]
  submissions Submission[]
  payments    Payment[]

  @@index([submissionsCloseAt])
}

model ConferenceOrganiser {
  conferenceId String     @db.Uuid
  conference   Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  addedAt DateTime @default(now())

  @@id([conferenceId, userId])
  @@index([userId])
}

/// A payment from a conference's organisers, recorded by an administrator.
model Payment {
  id String @id @default(uuid(7)) @db.Uuid

  conferenceId String     @db.Uuid
  conference   Conference @relation(fields: [conferenceId], references: [id], onDelete: Restrict)

  /// In the currency's minor unit (kobo, cents), so no rounding ever happens.
  amountMinor Int
  currency    String
  description String
  reference   String?
  paidAt      DateTime

  recordedById String @db.Uuid
  recordedBy   User   @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  receiptNumber String    @unique
  receiptSentAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([conferenceId])
}

// ──────────────────────────────────────────────────────────────────────────
// Papers
// ──────────────────────────────────────────────────────────────────────────

model Submission {
  id String @id @default(uuid(7)) @db.Uuid

  /// Human-quotable identifier, e.g. "APR-2026-0147". Allocated atomically via
  /// ReferenceCounter so concurrent submissions cannot collide.
  reference String @unique

  conferenceId String     @db.Uuid
  conference   Conference @relation(fields: [conferenceId], references: [id], onDelete: Restrict)

  /// The person who submitted it and holds the account.
  authorId String @db.Uuid
  author   User   @relation("SubmissionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  title        String
  /// Every author, in order, as the submitter typed them.
  authorNames  String
  /// The main author's contact details.
  contactEmail String
  institution  String
  topic        String
  disciplineId String?     @db.Uuid
  discipline   Discipline? @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  /// Typed when the paper's discipline is not on the list.
  disciplineOther String?
  paperType    PaperType
  abstract     String

  /// When the submitter confirmed the paper is original and anonymised.
  declarationAt DateTime?

  status SubmissionStatus @default(DRAFT)

  decisionNote String?
  decidedAt    DateTime?
  decidedById  String?   @db.Uuid
  decidedBy    User?     @relation("SubmissionDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  submittedAt        DateTime?
  reviewsCompletedAt DateTime?
  withdrawnAt        DateTime?

  files         StoredFile[]
  assignments   Assignment[]
  reviews       Review[]
  notifications Notification[]
  emailLogs     EmailLog[]

  @@index([authorId, status])
  @@index([conferenceId, status])
  @@index([createdAt])
}

model StoredFile {
  id String @id @default(uuid(7)) @db.Uuid

  submissionId String     @db.Uuid
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  /// Set on a reviewer's marked-up copy: the review it belongs to.
  reviewId String? @db.Uuid
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  kind FileKind

  /// Object key in the bucket. Files are served through short-lived signed
  /// URLs, never from this origin.
  storageKey       String @unique
  originalFilename String
  mimeType         String
  sizeBytes        Int
  checksum         String

  uploadedById String @db.Uuid
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  /// Proof that names were stripped from the file's metadata. Every file is
  /// stored scrubbed; a row without this is never shown to anyone but its
  /// uploader.
  scrubbedAt DateTime?

  createdAt DateTime @default(now())

  @@index([submissionId, kind])
  @@index([reviewId])
}

// ──────────────────────────────────────────────────────────────────────────
// Reviewing
// ──────────────────────────────────────────────────────────────────────────

/// One reviewer being given one paper. A reviewer is never offered the same
/// paper twice: after declining, they are out of the running for it.
model Assignment {
  id String @id @default(uuid(7)) @db.Uuid

  submissionId String     @db.Uuid
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  reviewerId String @db.Uuid
  reviewer   User   @relation("AssignmentReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  /// Null when matched automatically.
  assignedById String? @db.Uuid
  assignedBy   User?   @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  status AssignmentStatus @default(PENDING)

  /// Added because the first reviews disagreed.
  isTiebreaker Boolean @default(false)

  dueAt DateTime

  /// How many of the deadline reminders (7, 3 and 1 days before) have gone.
  remindersSent Int @default(0)

  declineReason    String?
  /// The reviewer declined because they know the author or the work.
  conflictDeclared Boolean @default(false)

  assignedAt  DateTime  @default(now())
  acceptedAt  DateTime?
  declinedAt  DateTime?
  cancelledAt DateTime?
  completedAt DateTime?

  review Review?

  @@unique([submissionId, reviewerId])
  @@index([reviewerId, status])
  @@index([status, dueAt])
}

model Review {
  id String @id @default(uuid(7)) @db.Uuid

  submissionId String     @db.Uuid
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  assignmentId String     @unique @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  /// 1 (poor) to 5 (excellent).
  score     Int?
  /// Whether the reviewer recommends the paper for the conference.
  recommend Boolean?
  comments  String?

  status ReviewStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?

  files StoredFile[]

  @@index([submissionId])
}

// ──────────────────────────────────────────────────────────────────────────
// Notifications, email, audit
// ──────────────────────────────────────────────────────────────────────────

model Notification {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  body    String?
  linkUrl String?

  submissionId String?     @db.Uuid
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

/// Record of every outbound email, and the outbox for workflow mail.
model EmailLog {
  id String @id @default(uuid(7)) @db.Uuid

  toEmail  String
  template String
  subject  String

  submissionId String?     @db.Uuid
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  status     EmailStatus @default(QUEUED)
  providerId String?
  error      String?
  attempts   Int         @default(0)

  /// The body to render and send. Null on account emails, which contain a
  /// secret link and are sent once without keeping a copy.
  payload       Json?
  /// Earliest time the next attempt may run; doubles as a short send lease.
  nextAttemptAt DateTime?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([submissionId])
}

/// Append-only audit trail. Reviewer identity is always recorded here in full.
model ActivityLog {
  id String @id @default(uuid(7)) @db.Uuid

  /// Null for actions the system takes by itself, such as automatic matching.
  actorId   String? @db.Uuid
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole Role?

  action     String
  entityType String
  entityId   String @db.Uuid

  metadata Json?
  ip       String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────────────────
// System
// ──────────────────────────────────────────────────────────────────────────

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Per-year counters behind paper references and receipt numbers. Incremented
/// with a single atomic upsert, which is what makes concurrent use safe.
model ReferenceCounter {
  year      Int @id
  lastValue Int @default(0)
}

model ReceiptCounter {
  year      Int @id
  lastValue Int @default(0)
}

/// Fixed-window counter behind lib/rate-limit. Keys are hashed.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
