# ReviewFlow environment configuration.
#
# Copy to .env.local for development:   cp .env.example .env.local
# The committed defaults below point at the docker-compose stack, so a fresh
# clone runs with no edits. Production values are set in the host's dashboard.

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=ReviewFlow

# ─── Database ────────────────────────────────────────────────────────────────
# Dev: docker-compose Postgres. Prod: Neon pooled connection string.
DATABASE_URL=postgresql://reviewflow:reviewflow@localhost:5432/reviewflow?schema=public
# Production only: Neon's direct (non-pooled) string, used by the Prisma CLI for
# migrations. Leave unset in development.
# DIRECT_DATABASE_URL=

# ─── Sessions ────────────────────────────────────────────────────────────────
# 32+ random bytes. Generate with: openssl rand -base64 32
# Rotating this invalidates every active session.
SESSION_SECRET=dev-only-insecure-secret-replace-in-production-0000000000
SESSION_TTL_DAYS=30

# ─── File storage (S3-compatible: MinIO in dev, Cloudflare R2 in prod) ───────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=reviewflow-documents
STORAGE_ACCESS_KEY_ID=reviewflow
STORAGE_SECRET_ACCESS_KEY=reviewflow-secret
# MinIO needs path-style addressing; R2 does not.
STORAGE_FORCE_PATH_STYLE=true
# Lifetime of presigned upload/download URLs.
STORAGE_SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=20971520

# ─── Email ───────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER: "smtp" (Mailpit, dev) | "resend" (prod)
EMAIL_PROVIDER=smtp
EMAIL_FROM="ReviewFlow <noreply@localhost>"
EMAIL_REPLY_TO=

# smtp provider (dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false

# resend provider (prod) — requires a DNS-verified sending domain
RESEND_API_KEY=

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Shared secret the cron endpoint requires, so only the scheduler can fire it.
CRON_SECRET=dev-only-cron-secret-replace-in-production
# How many days before a deadline the reviewer reminder is sent.
DEADLINE_REMINDER_LEAD_DAYS=2
