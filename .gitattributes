# Normalise to LF in the repository. Development happens on Windows, but the
# app builds and runs on Linux (Vercel, Docker), so committing CRLF would cause
# spurious diffs and break any shell script.
* text=auto eol=lf

# Binary — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.docx binary

# Generated; collapse in diffs and reviews.
pnpm-lock.yaml linguist-generated=true -diff
